<section class="lux_section_root lux_band lux_ladder_section" id="lux-portraits-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="lux_wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="lux_section_title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.intro != blank -%}
      <p class="lux_intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    <div class="lux_switch" role="tablist" aria-label="Choose a line">
      <button type="button" class="lux_switch_btn lux_active" role="tab" data-line="{{ section.settings.tab_1_line_key | default: 'her' }}" aria-selected="true">
        {{ section.settings.tab_1_label | default: 'For her' }}
      </button>
      <button type="button" class="lux_switch_btn" role="tab" data-line="{{ section.settings.tab_2_line_key | default: 'him' }}" aria-selected="false">
        {{ section.settings.tab_2_label | default: 'For him' }}
      </button>
    </div>

    {%- assign line_1 = section.settings.tab_1_line_key | default: 'her' -%}
    {%- assign line_2 = section.settings.tab_2_line_key | default: 'him' -%}

    {%- comment -%} Container for all line groups {%- endcomment -%}
    <div class="lux_ladder_container">
      {%- for line_key in (1..2) -%}
        {%- liquid
          if line_key == 1
            assign current_line = line_1
            assign is_active_line = true
          else
            assign current_line = line_2
            assign is_active_line = false
          endif
        -%}
        <div class="lux_ladder_group {% unless is_active_line %}lux_hidden{% endunless %}" data-line="{{ current_line }}">
          <div class="lux_ladder" role="tablist" aria-label="Portraits for {{ current_line }}">
            {%- assign step_count = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.line == current_line -%}
                {%- assign step_count = step_count | plus: 1 -%}
                {%- assign is_first_step = false -%}
                {%- if step_count == 1 -%}{%- assign is_first_step = true -%}{%- endif -%}

                <button
                  class="lux_step {% if is_first_step %}lux_active{% endif %}"
                  role="tab"
                  aria-selected="{% if is_first_step %}true{% else %}false{% endif %}"
                  tabindex="{% if is_first_step %}0{% else %}-1{% endif %}"
                  data-index="{{ step_count | minus: 1 }}"
                  data-quote="{{ block.settings.quote | escape }}"
                  data-pieces="{{ block.settings.pieces_description | escape }}"
                  data-availability="{{ block.settings.availability_text | escape }}"
                  data-price="{{ block.settings.price_text | escape }}"
                  data-btn-label="{{ block.settings.button_label | escape }}"
                  data-btn-link="{{ block.settings.button_link | default: '/collections/all' }}"
                  {{ block.shopify_attributes }}
                >
                  <span class="lux_icons">
                    {%- if block.settings.show_wash -%}
                      {% render 'lux-bottle-icon', shape: 'wash' %}
                    {%- endif -%}
                    {%- if block.settings.show_cream -%}
                      {% render 'lux-bottle-icon', shape: 'cream' %}
                    {%- endif -%}
                    {%- if block.settings.show_spray -%}
                      {% render 'lux-bottle-icon', shape: 'spray' %}
                    {%- endif -%}
                    {%- if block.settings.show_cloth -%}
                      {% render 'lux-bottle-icon', shape: 'cloth' %}
                    {%- endif -%}
                    {%- if block.settings.show_room -%}
                      {% render 'lux-bottle-icon', shape: 'room' %}
                    {%- endif -%}
                  </span>
                  <span class="lux_step_name">{{ block.settings.name }}</span>
                  <span class="lux_step_tier">{{ block.settings.label }}</span>
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- comment -%} Initial Server-rendered detail box for this line {%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.line == current_line -%}
              <div class="lux_ladder_detail" aria-live="polite">
                <div>
                  {%- if block.settings.quote != blank -%}
                    <p class="lux_quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
                  {%- endif -%}
                  {%- if block.settings.pieces_description != blank -%}
                    <p class="lux_pieces_text">{{ block.settings.pieces_description }}</p>
                  {%- endif -%}
                  {%- if block.settings.availability_text != blank -%}
                    <p class="lux_muted lux_avail_text">{{ block.settings.availability_text }}</p>
                  {%- endif -%}
                </div>
                <div>
                  {%- if block.settings.price_text != blank -%}
                    <p class="lux_muted lux_price_text" style="margin: 0 0 14px;">{{ block.settings.price_text }}</p>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank -%}
                    <a class="lux_btn_primary lux_action_btn" href="{{ block.settings.button_link | default: '/collections/all' }}">
                      {{ block.settings.button_label }}
                    </a>
                  {%- endif -%}
                </div>
              </div>
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

