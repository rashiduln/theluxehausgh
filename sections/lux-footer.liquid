<footer class="site lux_site_footer" id="lux-footer-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="wrap">
    
    {%- comment -%} 1. Newsletter Dispatch {%- endcomment -%}
    {%- if section.settings.show_newsletter -%}
      <div class="footer-dispatch">
        <div class="dispatch-content">
          <span class="dispatch-tag">{{ section.settings.newsletter_tag | default: 'THE PRIVATE DISPATCH' }}</span>
          <h3 class="dispatch-title">{{ section.settings.newsletter_heading | default: 'Receive new scent releases, seasonal notes, and private viewing announcements.' }}</h3>
          <p class="dispatch-sub">{{ section.settings.newsletter_sub | default: 'Delivered quietly. No spam, strictly private allocations and fragrance routine care.' }}</p>
        </div>
        {%- form 'customer', id: 'lux-dispatch-form', class: 'dispatch-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="dispatch-input-wrap">
            <input
              type="email"
              name="contact[email]"
              id="lux-dispatch-email"
              placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email address' }}"
              required
              aria-label="Email for private dispatch"
              value="{% if customer %}{{ customer.email }}{% endif %}"
              autocorrect="off"
              autocapitalize="off"
            >
            <button type="submit" class="btn-primary" id="lux-dispatch-btn">
              {{ section.settings.newsletter_button_text | default: 'Join the House' }}
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="dispatch-feedback" aria-live="polite">
              {{ section.settings.newsletter_success_text | default: 'Thank you. You have been added to the Private Dispatch list.' }}
            </p>
          {%- elsif form.errors -%}
            <p class="dispatch-feedback error" aria-live="polite">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- comment -%} 2. Assurance Highlights {%- endcomment -%}
    {%- assign highlight_blocks = section.blocks | where: 'type', 'highlight' -%}
    {%- if section.settings.show_highlights and highlight_blocks.size > 0 -%}
      <div class="footer-highlights">
        {%- for block in highlight_blocks -%}
          <div class="highlight-item" {{ block.shopify_attributes }}>
            <div class="highlight-icon" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 80 | image_tag: class: 'highlight-custom-img', loading: 'lazy', alt: block.settings.title }}
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 18h14M5 14h14M3 9l3-5h12l3 5v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z"/></svg>
                  {%- when 'chat' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                  {%- when 'gift' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                  {%- when 'sparkle' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4L12 2z"/></svg>
                  {%- when 'box' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                  {%- when 'lock' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  {%- when 'phone' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>
                {%- endcase -%}
              {%- endif -%}
            </div>
            <div>
              <strong>{{ block.settings.title }}</strong>
              <span>{{ block.settings.text }}</span>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} 3. Navigation Menu Grid {%- endcomment -%}
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-col footer-brand">
        <a class="wordmark" href="{{ routes.root_url }}" aria-label="The Luxé Haus, home">
          <span class="the">THE</span><span class="luxe">LUXÉ</span><span class="haus">HAUS</span>
        </a>
        <p>{{ section.settings.brand_text | default: 'Curated fragrance and body care routines, sourced sealed and delivered across Ghana. An online house for now, with a storefront coming.' }}</p>
        <div class="footer-contact-list">
          {%- if section.settings.whatsapp_number != blank or section.settings.whatsapp_url != blank -%}
            <a class="footer-contact-item" href="{{ section.settings.whatsapp_url | default: 'https://wa.me/233559100626' }}" target="_blank" rel="noopener" aria-label="WhatsApp Concierge">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              <span>{{ section.settings.whatsapp_label | default: 'WhatsApp: +233 55 910 0626' }}</span>
            </a>
          {%- endif -%}
          {%- if section.settings.instagram_url != blank -%}
            <a class="footer-contact-item" href="{{ section.settings.instagram_url | default: 'https://instagram.com/theluxehausgh' }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              <span>{{ section.settings.instagram_label | default: 'Instagram: @theluxehausgh' }}</span>
            </a>
          {%- endif -%}
          <div class="footer-contact-item" style="color: var(--lux-muted, var(--muted));">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{{ section.settings.location_text | default: 'Accra, Ghana • Nationwide Delivery' }}</span>
          </div>
        </div>
      </div>

      <!-- Dynamic Menu Column Blocks -->
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <details class="footer-col footer-accordion" open {{ block.shopify_attributes }}>
              <summary class="footer-col-title">
                <span>{{ block.settings.title | default: block.settings.menu.title | default: 'Quick Links' }}</span>
                <span class="toggle-icon" aria-hidden="true"></span>
              </summary>
              <ul class="footer-links">
                {%- if block.settings.menu != blank -%}
                  {%- for link in linklists[block.settings.menu].links -%}
                    {%- assign badge_text = '' -%}
                    {%- assign display_title = link.title -%}

                    {%- comment -%} 1. Check for custom badge in title syntax like 'Title [Badge]' or 'Title | Badge' {%- endcomment -%}
                    {%- if link.title contains '[' and link.title contains ']' -%}
                      {%- assign title_parts = link.title | split: '[' -%}
                      {%- assign display_title = title_parts[0] | strip -%}
                      {%- assign badge_text = title_parts[1] | remove: ']' | strip -%}
                    {%- elsif link.title contains '|' -%}
                      {%- assign title_parts = link.title | split: '|' -%}
                      {%- assign display_title = title_parts[0] | strip -%}
                      {%- assign badge_text = title_parts[1] | strip -%}
                    {%- elsif link.url contains '/collections/' -%}
                      {%- comment -%} 2. Check for Shopify collection tag filter in URL (e.g. /collections/all/mists-and-sets) {%- endcomment -%}
                      {%- assign url_clean = link.url | split: '?' | first -%}
                      {%- assign url_after_collections = url_clean | split: '/collections/' | last -%}
                      {%- assign path_parts = url_after_collections | split: '/' -%}
                      {%- if path_parts.size > 1 and path_parts[1] != blank -%}
                        {%- assign badge_text = path_parts[1] | replace: '-', ' ' | replace: '_', ' ' | capitalize -%}
                      {%- endif -%}
                    {%- endif -%}
 

                    <li>
                      <a href="{{ link.url }}">
                        {{ display_title }}
                        {%- if badge_text != blank -%}
                          <span class="badge-tag">{{ badge_text }}</span>
                        {%- endif -%}
                      </a>
                    </li>
                  {%- endfor -%}
                {%- else -%}
                  {%- case forloop.index -%}
                    {%- when 1 -%}
                      <li><a href="/collections/all?line=her">For Her <span class="badge-tag">Mists &amp; Sets</span></a></li>
                      <li><a href="/collections/all?line=him">For Him <span class="badge-tag">Body Sprays</span></a></li>
                      <li><a href="/collections/all?view=gifting">Gifting Collection</a></li>
                      <li><a href="/products/the-trio-gift-set">The Trio Gift Set</a></li>
                      <li><a href="/collections/all">All Fragrances</a></li>
                      <li><a href="/pages/refills">Refills &amp; Care Essentials</a></li>
                    {%- when 2 -%}
                      <li><a href="/pages/house-call">Book a House Call</a></li>
                      <li><a href="/#portraits">The 3-Step Routine</a></li>
                      <li><a href="/#portraits">Portrait Standards</a></li>
                      <li><a href="/collections/all?signature=1">Signature Editions</a></li>
                      <li><a href="/pages/refills">Exfoliating African Net Cloth</a></li>
                      <li><a href="https://wa.me/233559100626?text=Hello%2C%20I%20am%20interested%20in%20custom%20or%20wedding%20gifting" target="_blank" rel="noopener">Bespoke &amp; Wedding Gifting</a></li>
                    {%- else -%}
                      <li><a href="/pages/delivery">Delivery &amp; Dispatch</a></li>
                      <li><a href="/pages/authenticity">Authenticity Guarantee</a></li>
                      <li><a href="/pages/faq">House FAQ</a></li>
                      <li><a href="https://wa.me/233559100626" target="_blank" rel="noopener">Concierge Support</a></li>
                      <li><a href="{{ routes.cart_url }}">Order Status &amp; Bag</a></li>
                  {%- endcase -%}
                {%- endif -%}
              </ul>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <!-- 4. Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-copy">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: 'The Luxé Haus. Luxury is demonstrated, not declared.' }}
      </div>
    </div>

  </div>
</footer>

<style>
  /* Footer Section Base Styles */
  footer.lux_site_footer {
    background: linear-gradient(180deg, var(--lux-ground, #0B0B0C) 0%, #140d0e 40%, #0c0809 100%);
    border-top: 1px solid var(--lux-rule, rgba(201, 180, 138, 0.22));
    padding: 72px 0 36px;
    color: var(--lux-muted, #A89C8C);
    font-size: 16px;
    position: relative;
    font-family: var(--lux-text, "EB Garamond", Garamond, Georgia, serif);
  }
  footer.lux_site_footer .wrap {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 28px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* Wordmark */
  footer.lux_site_footer .wordmark {
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    white-space: nowrap;
    margin-bottom: 16px;
  }
  footer.lux_site_footer .wordmark .the {
    font-family: var(--lux-display, "Cinzel", Georgia, serif);
    font-size: 12px;
    letter-spacing: .08em;
    color: var(--lux-champagne, #C9B48A);
  }
  footer.lux_site_footer .wordmark .luxe {
    font-family: var(--lux-display, "Cinzel", Georgia, serif);
    font-size: 23px;
    font-weight: 500;
    letter-spacing: .06em;
    color: var(--lux-ember, #D8611A);
  }
  footer.lux_site_footer .wordmark .haus {
    font-family: var(--lux-display, "Cinzel", Georgia, serif);
    font-size: 17px;
    letter-spacing: .08em;
    color: var(--lux-ivory, #EDE6DA);
  }

  /* Newsletter Dispatch */
  footer.lux_site_footer .footer-dispatch {
    background: rgba(69, 42, 36, 0.22);
    border: 1px solid var(--lux-rule, rgba(201, 180, 138, 0.22));
    padding: 36px 40px;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 36px;
    align-items: center;
  }
  footer.lux_site_footer .dispatch-tag {
    font-family: var(--lux-display, "Cinzel", Georgia, serif);
    font-size: 13px;
    letter-spacing: .12em;
    color: var(--lux-champagne, #C9B48A);
    display: block;
    margin-bottom: 8px;
  }
  footer.lux_site_footer .dispatch-title {
    font-family: var(--lux-display, "Cinzel", Georgia, serif);
    font-weight: 400;
    font-size: clamp(20px, 2.2vw, 26px);
    line-height: 1.25;
    color: var(--lux-ivory, #EDE6DA);
    margin: 0 0 8px;
  }
  footer.lux_site_footer .dispatch-sub {
    color: var(--lux-muted, #A89C8C);
    font-size: 15px;
    margin: 0;
  }
  footer.lux_site_footer .dispatch-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  footer.lux_site_footer .dispatch-input-wrap {
    display: flex;
    gap: 10px;
  }
  footer.lux_site_footer .dispatch-input-wrap input {
    flex: 1;
    background: var(--lux-panel, #151112);
    border: 1px solid var(--lux-rule, rgba(201, 180, 138, 0.22));
    color: var(--lux-ivory, #EDE6DA);
    padding: 12px 16px;
    font-family: var(--lux-text, "EB Garamond", Georgia, serif);
    font-size: 16px;
    min-width: 0;
  }
  footer.lux_site_footer .dispatch-input-wrap input:focus {
    outline: none;
    border-color: var(--lux-ember, #D8611A);
  }
  footer.lux_site_footer .dispatch-input-wrap .btn-primary {
    display: inline-block;
    background: var(--lux-ember, #D8611A);
    color: #140b08;
    padding: 12px 22px;
    font-size: 16px;
    border: none;
    cursor: pointer;
    text-align: center;
    white-space: nowrap;
    font-family: var(--lux-text, "EB Garamond", Georgia, serif);
    transition: background 0.2s ease;
  }
  footer.lux_site_footer .dispatch-input-wrap .btn-primary:hover {
    background: #e2742f;
  }
  footer.lux_site_footer .dispatch-feedback {
    font-size: 15px;
    color: var(--lux-champagne, #C9B48A);
    margin: 2px 0 0;
  }
  footer.lux_site_footer .dispatch-feedback.error {
    color: #e08a6a;
  }

  /* Assurance Highlights */
  footer.lux_site_footer .footer-highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--lux-rule, rgba(201, 180, 138, 0.22));
  }
  footer.lux_site_footer .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  footer.lux_site_footer .highlight-icon {
    width: 42px;
    height: 42px;
    border: 1px solid var(--lux-rule, rgba(201, 180, 138, 0.22));
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--lux-ember, #D8611A);
    background: rgba(59, 42, 36, 0.2);
    overflow: hidden;
  }
  footer.lux_site_footer .highlight-icon .highlight-custom-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    padding: 6px;
  }
  footer.lux_site_footer .highlight-item strong {
    display: block;
    font-family: var(--lux-display, "Cinzel", Georgia, serif);
    font-weight: 400;
    font-size: 16px;
    letter-spacing: .04em;
    color: var(--lux-ivory, #EDE6DA);
    margin-bottom: 4px;
  }
  footer.lux_site_footer .highlight-item span {
    font-size: 14px;
    color: var(--lux-muted, #A89C8C);
    line-height: 1.4;
    display: block;
  }

  /* Main Navigation Grid */
  footer.lux_site_footer .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.1fr;
    gap: 48px;
  }
  footer.lux_site_footer .footer-col-title {
    font-family: var(--lux-display, "Cinzel", Georgia, serif);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--lux-champagne, #C9B48A);
    margin: 0 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }
  footer.lux_site_footer .footer-col-title::-webkit-details-marker {
    display: none;
  }
  footer.lux_site_footer .footer-col p {
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 16px;
    color: var(--lux-muted, #A89C8C);
  }
  footer.lux_site_footer .footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 18px;
    font-size: 15px;
  }
  footer.lux_site_footer .footer-contact-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--lux-muted, #A89C8C);
    text-decoration: none;
    transition: color .2s ease;
  }
  footer.lux_site_footer .footer-contact-item:hover {
    color: var(--lux-ivory, #EDE6DA);
  }
  footer.lux_site_footer .footer-contact-item svg {
    flex-shrink: 0;
    color: var(--lux-champagne, #C9B48A);
  }
  footer.lux_site_footer .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  footer.lux_site_footer .footer-links a {
    color: var(--lux-muted, #A89C8C);
    text-decoration: none;
    font-size: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color .2s ease, transform .2s ease;
  }
  footer.lux_site_footer .footer-links a:hover {
    color: var(--lux-ivory, #EDE6DA);
    transform: translateX(3px);
  }
  footer.lux_site_footer .badge-tag {
    font-size: 11px;
    letter-spacing: .05em;
    background: rgba(216, 97, 26, 0.18);
    color: var(--lux-ember, #D8611A);
    padding: 2px 7px;
    border: 1px solid rgba(216, 97, 26, 0.4);
  }
  footer.lux_site_footer .toggle-icon {
    display: none;
  }

  /* Desktop mode: always open, static header */
  @media (min-width: 769px) {
    footer.lux_site_footer details.footer-accordion {
      pointer-events: auto;
    }
    footer.lux_site_footer details.footer-accordion summary.footer-col-title {
      pointer-events: none;
      cursor: default;
    }
  }

  /* Bottom Bar */
  footer.lux_site_footer .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-top: 32px;
    border-top: 1px solid var(--lux-rule, rgba(201, 180, 138, 0.22));
    font-size: 14px;
    flex-wrap: wrap;
  }
  footer.lux_site_footer .footer-copy {
    color: var(--lux-muted, #A89C8C);
  }

  /* Responsive Mobile View */
  @media (max-width: 960px) {
    footer.lux_site_footer .footer-dispatch {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 28px 24px;
    }
    footer.lux_site_footer .footer-highlights {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
  @media (max-width: 768px) {
    footer.lux_site_footer .footer-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    footer.lux_site_footer .footer-brand {
      border-bottom: 1px solid var(--lux-rule, rgba(201, 180, 138, 0.22));
      padding-bottom: 24px;
      margin-bottom: 6px;
    }
    footer.lux_site_footer details.footer-accordion {
      border-bottom: 1px solid var(--lux-rule, rgba(201, 180, 138, 0.22));
      padding-bottom: 6px;
    }
    footer.lux_site_footer details.footer-accordion summary.footer-col-title {
      cursor: pointer;
      padding: 12px 0;
      margin: 0;
      font-size: 15px;
      letter-spacing: .08em;
      transition: color 0.2s ease;
    }
    footer.lux_site_footer details.footer-accordion[open] summary.footer-col-title {
      color: var(--lux-ivory, #EDE6DA);
      margin-bottom: 10px;
    }
    footer.lux_site_footer .toggle-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      color: var(--lux-champagne, #C9B48A);
    }
    footer.lux_site_footer .toggle-icon::before {
      content: "";
      width: 8px;
      height: 8px;
      border-right: 1.5px solid var(--lux-champagne, #C9B48A);
      border-bottom: 1.5px solid var(--lux-champagne, #C9B48A);
      transform: rotate(45deg);
      transition: transform 0.25s ease, border-color 0.2s ease;
      display: block;
      margin-bottom: 2px;
    }
    footer.lux_site_footer details.footer-accordion[open] .toggle-icon::before {
      transform: rotate(-135deg);
      border-color: var(--lux-ember, #D8611A);
      margin-bottom: -4px;
    }
    footer.lux_site_footer details.footer-accordion .footer-links {
      padding-bottom: 12px;
    }
    footer.lux_site_footer .dispatch-input-wrap {
      flex-direction: column;
    }
    footer.lux_site_footer .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>

<script>
  (function () {
    const footerEl = document.getElementById('lux-footer-{{ section.id }}');
    if (!footerEl) return;

    function initFooterAccordions() {
      const isMobile = window.innerWidth <= 768;
      footerEl.querySelectorAll('details.footer-accordion').forEach(function (d) {
        if (isMobile) {
          d.removeAttribute('open');
        } else {
          d.setAttribute('open', '');
        }
      });
    }

    window.addEventListener('resize', initFooterAccordions);
    initFooterAccordions();
  })();
</script>

