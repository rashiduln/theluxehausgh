<section class="lux_section_root lux_band" id="lux-three-forms-{{ section.id }}">
  <div class="lux_wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="lux_section_title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.intro != blank -%}
      <p class="lux_intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    <div class="lux_three">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="lux_piece" {{ block.shopify_attributes }}>
            {% render 'lux-bottle-icon', shape: block.settings.bottle_shape %}
            {%- if block.settings.title != blank -%}
              <h3 class="lux_piece_title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p>{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="lux_piece">
          {% render 'lux-bottle-icon', shape: 'wash' %}
          <h3 class="lux_piece_title">The wash</h3>
          <p>Starts it. The first layer of scent, and it cleans without fighting what comes next.</p>
        </div>
        <div class="lux_piece">
          {% render 'lux-bottle-icon', shape: 'cream' %}
          <h3 class="lux_piece_title">The cream</h3>
          <p>Holds it. Fragrance lasts on moisturized skin, so the cream carries the scent through the day.</p>
        </div>
        <div class="lux_piece">
          {% render 'lux-bottle-icon', shape: 'spray' %}
          <h3 class="lux_piece_title">The mist or body spray</h3>
          <p>Finishes it. The part people notice. Mist for her. For him, a deodorizing body spray: scent and freshness that hold up in the heat.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luxé Three Forms",
  "tag": "section",
  "class": "lux_section_three_forms_wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One scent, three forms, each with a job."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro Paragraph",
      "default": "Most sellers sell the mist on its own, and it fades by afternoon. Every set in this house starts with all three, because the scent only lasts when they work together."
    }
  ],
  "blocks": [
    {
      "type": "piece",
      "name": "Routine Step",
      "settings": [
        {
          "type": "select",
          "id": "bottle_shape",
          "label": "Bottle Icon Shape",
          "options": [
            { "value": "wash", "label": "Wash" },
            { "value": "cream", "label": "Cream" },
            { "value": "spray", "label": "Spray / Mist" },
            { "value": "cloth", "label": "Cloth" },
            { "value": "room", "label": "Room Mist" }
          ],
          "default": "wash"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "The wash"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Starts it. The first layer of scent, and it cleans without fighting what comes next."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxé Three Forms",
      "blocks": [
        {
          "type": "piece",
          "settings": {
            "bottle_shape": "wash",
            "title": "The wash",
            "description": "Starts it. The first layer of scent, and it cleans without fighting what comes next."
          }
        },
        {
          "type": "piece",
          "settings": {
            "bottle_shape": "cream",
            "title": "The cream",
            "description": "Holds it. Fragrance lasts on moisturized skin, so the cream carries the scent through the day."
          }
        },
        {
          "type": "piece",
          "settings": {
            "bottle_shape": "spray",
            "title": "The mist or body spray",
            "description": "Finishes it. The part people notice. Mist for her. For him, a deodorizing body spray: scent and freshness that hold up in the heat."
          }
        }
      ]
    }
  ]
}
{% endschema %}
