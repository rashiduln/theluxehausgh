<section class="lux_section_root lux_band lux_story" id="lux-story-{{ section.id }}">
  <div class="lux_wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="lux_section_title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.paragraph_1 != blank -%}
      <p>{{ section.settings.paragraph_1 }}</p>
    {%- endif -%}

    {%- if section.settings.paragraph_2 != blank -%}
      <p>{{ section.settings.paragraph_2 }}</p>
    {%- endif -%}

    {%- if section.settings.seal != blank -%}
      <p class="lux_seal">{{ section.settings.seal }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Luxé Brand Story",
  "tag": "section",
  "class": "lux_section_story_wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Founded in Ghana to answer a market that deserved better."
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "Better quality, better trust, and a standard that had simply never been offered. We are building what didn't exist."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "We are not the loudest store in Ghana. We are not the cheapest, and we never will be. What we are is certain. Certain of what we carry, of how it arrives, and of the people we built this for."
    },
    {
      "type": "text",
      "id": "seal",
      "label": "Seal / Tagline",
      "default": "Luxury is demonstrated, not declared."
    }
  ],
  "presets": [
    {
      "name": "Luxé Brand Story"
    }
  ]
}
{% endschema %}
