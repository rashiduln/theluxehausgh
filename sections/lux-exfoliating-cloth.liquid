<section class="lux_section_root lux_band" id="lux-cloth-{{ section.id }}">
  <div class="lux_wrap lux_cloth">
    <div class="lux_cloth_art" aria-hidden="true">
      {%- if section.settings.custom_image != blank -%}
        <img src="{{ section.settings.custom_image | image_url: width: 700 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {%- else -%}
        <svg viewBox="0 0 300 220" role="img" aria-label="The exfoliating cloth, woven net with an African print edge">
          <defs>
            <pattern id="net-{{ section.id }}" width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <rect width="12" height="12" fill="#1a1214"/>
              <path d="M0 0H12M0 0V12" stroke="#C9B48A" stroke-width="1.4" opacity=".55"/>
            </pattern>
            <pattern id="print-{{ section.id }}" width="18" height="18" patternUnits="userSpaceOnUse">
              <rect width="18" height="18" fill="#3B2A24"/>
              <circle cx="9" cy="9" r="5" fill="none" stroke="#D8611A" stroke-width="2"/>
              <circle cx="9" cy="9" r="1.6" fill="#C9B48A"/>
            </pattern>
          </defs>
          <rect x="10" y="10" width="280" height="200" fill="url(#print-{{ section.id }})"/>
          <rect x="24" y="24" width="252" height="172" fill="url(#net-{{ section.id }})"/>
        </svg>
      {%- endif -%}
    </div>

    <div class="lux_cloth_content">
      {%- if section.settings.heading != blank -%}
        <h2 class="lux_section_title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p>{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.settings.muted_note != blank -%}
        <p class="lux_muted">{{ section.settings.muted_note }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luxé Exfoliating Cloth",
  "tag": "section",
  "class": "lux_section_cloth_wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The part of the routine that does the work."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Our exfoliating cloth is woven net, finished with African print. It clears the skin before the wash, so everything after it lands better. It comes in every Elevated and Signature set, and it's the first piece that carries our own name."
    },
    {
      "type": "textarea",
      "id": "muted_note",
      "label": "Muted Note",
      "default": "Rinse after use and hang to dry. Replace every three months."
    },
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Custom Image (Optional, replaces SVG)"
    }
  ],
  "presets": [
    {
      "name": "Luxé Exfoliating Cloth"
    }
  ]
}
{% endschema %}
