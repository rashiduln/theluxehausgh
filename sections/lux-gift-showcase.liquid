<section class="lux_section_root lux_band" id="lux-gifts-{{ section.id }}">
  <div class="lux_wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="lux_section_title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.intro != blank -%}
      <p class="lux_intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    <div class="lux_grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign product = block.settings.product
            assign title = block.settings.title | default: product.title
            assign meta = block.settings.meta
            assign tone = block.settings.tone_color | default: '#2e231c'
            assign price_text = block.settings.price_text
            assign bottle_shape = block.settings.bottle_shape | default: 'spray'
            assign url = block.settings.link | default: product.url | default: '/collections/all'
          -%}
          <a class="lux_tile" href="{{ url }}" {{ block.shopify_attributes }}>
            <div class="lux_swatch" style="background: linear-gradient(180deg, {{ tone }}, #0f0c0c);">
              {%- if block.settings.custom_image != blank -%}
                <img src="{{ block.settings.custom_image | image_url: width: 600 }}" alt="{{ title | escape }}" loading="lazy">
              {%- else -%}
                {% render 'lux-bottle-icon', shape: bottle_shape %}
              {%- endif -%}
            </div>
            <p class="lux_t_name">{{ title }}</p>
            {%- if meta != blank -%}
              <p class="lux_t_meta">{{ meta }}</p>
            {%- endif -%}
            {%- if price_text != blank -%}
              <p class="lux_t_price">{{ price_text }}</p>
            {%- elsif product != blank -%}
              <p class="lux_t_price">{{ product.price | money }}</p>
            {%- endif -%}
          </a>
        {%- endfor -%}
      {%- else -%}
        <a class="lux_tile" href="/collections/all">
          <div class="lux_swatch" style="background: linear-gradient(180deg, #34211a, #0f0c0c);">
            {% render 'lux-bottle-icon', shape: 'spray' %}
          </div>
          <p class="lux_t_name">Mahogany Teakwood</p>
          <p class="lux_t_meta">Warm and grounded. Signature available</p>
          <p class="lux_t_price">From GHS 600</p>
        </a>
        <a class="lux_tile" href="/collections/all">
          <div class="lux_swatch" style="background: linear-gradient(180deg, #3d3122, #0f0c0c);">
            {% render 'lux-bottle-icon', shape: 'spray' %}
          </div>
          <p class="lux_t_name">Champagne Toast</p>
          <p class="lux_t_meta">Bright and celebratory. Signature available</p>
          <p class="lux_t_price">From GHS 600</p>
        </a>
        <a class="lux_tile" href="/collections/all">
          <div class="lux_swatch" style="background: linear-gradient(180deg, #2e231c, #0f0c0c);">
            {% render 'lux-bottle-icon', shape: 'spray' %}
          </div>
          <p class="lux_t_name">The Trio Gift Set</p>
          <p class="lux_t_meta">For him</p>
          <p class="lux_t_price">GHS 600</p>
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="lux_gift_note">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Luxé Gift Showcase",
  "tag": "section",
  "class": "lux_section_gift_showcase_wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A gift that says something about the giver."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro Paragraph",
      "default": "Every set arrives wrapped. Add a card message at checkout."
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote Text",
      "default": "The Distinguished Gentleman in Mahogany Teakwood and The Distinguished Woman in Champagne Toast. His warm and deep, hers bright. Two scents made to stand next to each other."
    }
  ],
  "blocks": [
    {
      "type": "gift_tile",
      "name": "Gift Item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The Trio Gift Set"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Tagline / Meta",
          "default": "For him"
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Price Text",
          "default": "GHS 600"
        },
        {
          "type": "color",
          "id": "tone_color",
          "label": "Swatch Gradient Tone",
          "default": "#2E231C"
        },
        {
          "type": "select",
          "id": "bottle_shape",
          "label": "Bottle Shape",
          "options": [
            { "value": "wash", "label": "Wash" },
            { "value": "cream", "label": "Cream" },
            { "value": "spray", "label": "Spray / Mist" },
            { "value": "cloth", "label": "Cloth" },
            { "value": "room", "label": "Room Mist" }
          ],
          "default": "spray"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (Optional, replaces SVG)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxé Gift Showcase",
      "blocks": [
        {
          "type": "gift_tile",
          "settings": {
            "title": "Mahogany Teakwood",
            "meta": "Warm and grounded. Signature available",
            "price_text": "From GHS 600",
            "tone_color": "#34211A",
            "bottle_shape": "spray"
          }
        },
        {
          "type": "gift_tile",
          "settings": {
            "title": "Champagne Toast",
            "meta": "Bright and celebratory. Signature available",
            "price_text": "From GHS 600",
            "tone_color": "#3D3122",
            "bottle_shape": "spray"
          }
        },
        {
          "type": "gift_tile",
          "settings": {
            "title": "The Trio Gift Set",
            "meta": "For him",
            "price_text": "GHS 600",
            "tone_color": "#2E231C",
            "bottle_shape": "spray"
          }
        }
      ]
    }
  ]
}
{% endschema %}
