{%- liquid
  assign current_page_product = closest.product | default: product
  assign sets_variants = current_page_product.metafields.custom.sets_variant.value | default: current_page_product.metafields.custom.sets_variant

  if sets_variants == blank and product != blank
    assign sets_variants = product.metafields.custom.sets_variant.value | default: product.metafields.custom.sets_variant
  endif

  if request.visual_preview_mode and sets_variants == blank
    assign sets_variants = collections.all.products | slice: 0, 3
    if sets_variants == blank
      assign sets_variants = all_products
    endif
  endif
-%}

{%- if sets_variants != blank and sets_variants.size > 0 -%}
  <div class="lux_portrait_block_wrapper" id="lux-portrait-block-{{ block.id }}" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <div class="lux_sets_variant_heading">{{ block.settings.heading }}</div>
    {%- endif -%}

    <div class="lux_sets_variant_list">
      {%- for target_product in sets_variants -%}
        {%- liquid
          if target_product == blank
            continue
          endif

          # 1. Option Title: custom.set_title fallback to product title
          assign option_title = target_product.metafields.custom.set_title.value | default: target_product.metafields.custom.set_title | default: target_product.title

          # 2. Option Subtitle: custom.set_subtitle
          assign option_subtitle = target_product.metafields.custom.set_subtitle.value | default: target_product.metafields.custom.set_subtitle

          assign is_current_product = false
          if current_page_product != blank and current_page_product.id == target_product.id
            assign is_current_product = true
          endif

          # 3. Prices
          assign current_variant = target_product.selected_or_first_available_variant
          assign is_available = target_product.available
          assign product_price = current_variant.price | default: target_product.price
          assign price_formatted = product_price | money

          assign compare_price_cents = 0
          if target_product.compare_at_price > product_price
            assign compare_price_cents = target_product.compare_at_price
          elsif current_variant.compare_at_price > product_price
            assign compare_price_cents = current_variant.compare_at_price
          endif

          assign compare_price_formatted = ''
          if compare_price_cents > product_price
            assign compare_price_formatted = compare_price_cents | money
          endif
        -%}

        {%- if is_current_product -%}
          <div
            class="lux_opt lux_portrait_card lux_selected {% unless is_available %}lux_opt_soldout{% endunless %}"
            aria-current="page"
          >
            <span class="lux_opt_radio_indicator" aria-hidden="true"></span>
            <span class="lux_opt_body">
              <span class="lux_o_name">{{ option_title }}</span>
              {%- if option_subtitle != blank -%}
                <span class="lux_o_contents">{{ option_subtitle }}</span>
              {%- endif -%}
            </span>
            <span class="lux_o_price">
              {%- if is_available -%}
                {%- if compare_price_formatted != blank -%}
                  <s class="lux_o_compare_price">{{ compare_price_formatted }}</s>
                {%- endif -%}
                <span class="lux_o_final_price">{{ price_formatted }}</span>
              {%- else -%}
                <span class="lux_soldout_badge">Sold out</span>
              {%- endif -%}
            </span>
          </div>
        {%- else -%}
          <a
            href="{{ target_product.url }}"
            class="lux_opt lux_portrait_card {% unless is_available %}lux_opt_soldout{% endunless %}"
          >
            <span class="lux_opt_radio_indicator" aria-hidden="true"></span>
            <span class="lux_opt_body">
              <span class="lux_o_name">{{ option_title }}</span>
              {%- if option_subtitle != blank -%}
                <span class="lux_o_contents">{{ option_subtitle }}</span>
              {%- endif -%}
            </span>
            <span class="lux_o_price">
              {%- if is_available -%}
                {%- if compare_price_formatted != blank -%}
                  <s class="lux_o_compare_price">{{ compare_price_formatted }}</s>
                {%- endif -%}
                <span class="lux_o_final_price">{{ price_formatted }}</span>
              {%- else -%}
                <span class="lux_soldout_badge">Sold out</span>
              {%- endif -%}
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <style>
    .lux_portrait_block_wrapper {
      margin: 12px 0;
      width: 100%;
    }
    .lux_sets_variant_heading {
      font-family: var(--lux-display, "Cinzel", Georgia, serif);
      font-size: 13px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--lux-champagne, #C9B48A);
      margin-bottom: 8px;
    }
    .lux_sets_variant_list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .lux_portrait_card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 14px;
      align-items: center;
      border: 1px solid var(--lux-rule, rgba(201, 180, 138, 0.22));
      padding: 14px 16px;
      background: rgba(59, 42, 36, 0.18);
      text-decoration: none;
      color: var(--lux-ivory, #EDE6DA);
      transition: all 0.25s ease;
      cursor: pointer;
    }
    .lux_portrait_card:hover:not(.lux_selected) {
      border-color: var(--lux-ember, #D8611A);
      background: rgba(69, 42, 36, 0.35);
      color: var(--lux-ivory, #EDE6DA);
    }
    .lux_portrait_card.lux_selected {
      border-color: var(--lux-ember, #D8611A);
      background: rgba(69, 42, 36, 0.35);
      cursor: default;
    }
    .lux_portrait_card .lux_opt_radio_indicator {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      border: 1px solid var(--lux-rule, rgba(201, 180, 138, 0.4));
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      position: relative;
      transition: all 0.2s ease;
    }
    .lux_portrait_card:hover:not(.lux_selected) .lux_opt_radio_indicator {
      border-color: var(--lux-ember, #D8611A);
    }
    .lux_portrait_card.lux_selected .lux_opt_radio_indicator {
      border-color: var(--lux-ember, #D8611A);
      background: radial-gradient(circle at center, var(--lux-ember, #D8611A) 42%, transparent 48%);
    }
    .lux_portrait_card .lux_o_name {
      font-family: var(--lux-display, "Cinzel", Georgia, serif);
      font-size: 17px;
      letter-spacing: 0.04em;
      display: block;
      color: var(--lux-ivory, #EDE6DA);
      line-height: 1.25;
    }
    .lux_portrait_card .lux_o_contents {
      font-size: 15px;
      color: var(--lux-muted, #A89C8C);
      display: block;
      margin-top: 3px;
      line-height: 1.35;
    }
    .lux_portrait_card .lux_o_price {
      font-size: 17px;
      white-space: nowrap;
      text-align: right;
      color: var(--lux-champagne, #C9B48A);
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 2px;
    }
    .lux_portrait_card .lux_o_compare_price {
      font-size: 14px;
      color: var(--lux-muted, #A89C8C);
      text-decoration: line-through;
    }
    .lux_portrait_card .lux_soldout_badge {
      font-size: 14px;
      color: var(--lux-muted, #A89C8C);
    }

    /* Seamless View Transition Animations */
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 0.22s;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
  </style>

  {%- if block.settings.enable_smooth_transition -%}
    <script>
      (function() {
        if (window.__luxSetsVariantTransitionInit) return;
        window.__luxSetsVariantTransitionInit = true;

        document.addEventListener('click', async function(e) {
          // Allow opening in new tab via Cmd/Ctrl/Shift/Middle-click
          if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;

          // Strictly scope to this block's variant card links
          const link = e.target.closest('.lux_portrait_block_wrapper .lux_portrait_card[href]');
          if (!link) return;

          const targetUrl = link.getAttribute('href');
          if (!targetUrl || targetUrl.startsWith('#') || targetUrl.startsWith('javascript:')) return;

          // Only handle internal product URLs for this block
          if (!targetUrl.includes('/products/')) return;

          e.preventDefault();

          // Visual feedback on the clicked card
          document.querySelectorAll('.lux_portrait_card').forEach(function(c) {
            c.classList.remove('lux_selected');
          });
          link.classList.add('lux_selected');

          // Find the container to transition
          const productSection = link.closest('.section') || link.closest('.product-information') || link.closest('.lux_product_main') || document.querySelector('main') || document.getElementById('app');

          try {
            if (productSection) {
              productSection.style.transition = 'opacity 0.18s ease';
              productSection.style.opacity = '0.6';
              productSection.style.pointerEvents = 'none';
            }

            const res = await fetch(targetUrl);
            if (!res.ok) throw new Error('Fetch failed');
            const html = await res.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            const performSwap = function() {
              if (doc.title) {
                document.title = doc.title;
              }

              const newProductSection = doc.querySelector('.section[data-testid*="product"]') || doc.querySelector('.product-information') || doc.querySelector('.lux_product_main') || doc.querySelector('main');
              
              if (newProductSection && productSection) {
                productSection.innerHTML = newProductSection.innerHTML;
                Array.from(newProductSection.attributes).forEach(function(attr) {
                  productSection.setAttribute(attr.name, attr.value);
                });
              } else {
                const currentMain = document.querySelector('main');
                const newMain = doc.querySelector('main');
                if (currentMain && newMain) {
                  currentMain.innerHTML = newMain.innerHTML;
                } else {
                  window.location.href = targetUrl;
                  return;
                }
              }

              // Update browser URL without reloading
              window.history.pushState({ path: targetUrl, isLuxSetsVariant: true }, '', targetUrl);

              if (productSection) {
                productSection.style.opacity = '1';
                productSection.style.pointerEvents = '';
              }

              // Re-dispatch events for theme scripts
              window.dispatchEvent(new Event('resize'));
              document.dispatchEvent(new CustomEvent('shopify:section:load'));
            };

            if (document.startViewTransition) {
              document.startViewTransition(performSwap);
            } else {
              performSwap();
            }
          } catch (err) {
            window.location.href = targetUrl;
          }
        });

        // Only handle popstate if navigated via this block
        window.addEventListener('popstate', function(e) {
          if (e.state && e.state.isLuxSetsVariant) {
            window.location.reload();
          }
        });
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Sets Variant",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (Optional)",
      "info": "Optional title displayed above the options list."
    },
    {
      "type": "checkbox",
      "id": "enable_smooth_transition",
      "label": "Enable smooth page change transition",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Sets Variant"
    }
  ]
}
{% endschema %}
