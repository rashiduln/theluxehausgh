{%- comment -%} Delivery area picker. Saved on the order as the cart attribute "Delivery area". Read by the Flow workflow "Delivery zone and cost tags". {%- endcomment -%}
{%- assign lh_area = cart.attributes['Delivery area'] -%}{%- assign lh_z5 = 'Ashaiman,Chorkor,Dansoman,Gbawe,James Town,Korle Bu,Korle Gonno,Mallam,Mamprobi,McCarthy Hill,Medie,Nungua,Weija,Tema Community 1,Tema Community 2,Tema Community 3,Tema Community 4,Tema Community 5,Tema Community 6,Tema Community 7,Tema Community 8,Tema Community 9,Tema Community 10,Tema Community 11,Tema Community 12,Tema Community 13,Tema Community 14,Tema Community 15,Tema Community 16,Tema Community 17,Tema Community 18,Tema Community 19,Tema Community 20,Tema Community 21,Tema Community 22,Tema Newtown,Tema Industrial Area' -%}{%- assign lh_z6 = 'Aburi,Afienya,Dawhenya,Dodowa,Kasoa,Kokrobite,Kpone,Nsawam,Prampram,Tema Community 23,Tema Community 24,Tema Community 25,Tema Community 26' -%}{%- assign lh_z5a = lh_z5 | split: ',' -%}{%- assign lh_z6a = lh_z6 | split: ',' -%}{%- assign lh_zone = 0 -%}{%- if lh_z5a contains lh_area -%}{%- assign lh_zone = 5 -%}{%- elsif lh_z6a contains lh_area -%}{%- assign lh_zone = 6 -%}{%- endif -%}
{%- assign lh_areas = 'Abeka,Abelemkpe,Abokobi,Abossey Okai,Aburi,Accra Mall,Achimota,Adabraka,Adenta,Adjiringanor,Afienya,Agbogba,Airport City,Airport Hills,Airport Residential,Akweteyman,Alajo,Amasaman,American House,Ashaiman,Ashaley Botwe,Ashongman,Ashongman Estate,Asylum Down,Atomic Junction,Awoshie,Ayimensah,Baatsona,Bawaleshie,Burma Camp,Cantonments,Chorkor,Christian Village,Danfa,Dansoman,Darkuman,Dawhenya,Dodowa,Dome,Dome Pillar 2,Dzorwulu,East Legon,East Legon Hills,Gbawe,Haatso,James Town,Kanda,Kaneshie,Kasoa,Kisseman,Kokomlemle,Kokrobite,Korle Bu,Korle Gonno,Kotobabi,Kpone,Kwabenya,Kwashieman,La (Labadi),Labone,Lakeside Estate,Lapaz,Lashibi,Legon (University of Ghana),Madina,Mallam,Mamprobi,Mataheko,McCarthy Hill,Medie,Mile 7,Musuko,Nima,North Kaneshie,North Legon,North Ridge,Nsawam,Nungua,Odorkor,Ofankor,Okponglo,Osu,Oyarifa,Oyibi,Palace Mall,Pantang,Pokuase,Prampram,Regimanuel,Ridge,Roman Ridge,Sakumono,Santa Maria,Shiashie,Spintex,Taifa,Tantra Hill,Tema Community 1,Tema Community 2,Tema Community 3,Tema Community 4,Tema Community 5,Tema Community 6,Tema Community 7,Tema Community 8,Tema Community 9,Tema Community 10,Tema Community 11,Tema Community 12,Tema Community 13,Tema Community 14,Tema Community 15,Tema Community 16,Tema Community 17,Tema Community 18,Tema Community 19,Tema Community 20,Tema Community 21,Tema Community 22,Tema Community 23,Tema Community 24,Tema Community 25,Tema Community 26,Tema Industrial Area,Tema Newtown,Tesano,Teshie,Tetteh Quarshie,Trasacco,Weija,West Legon,Westlands' | split: ',' -%}
<div class="lh-area" data-z5="{{ lh_z5 }}" data-z6="{{ lh_z6 }}" data-v5="57705186099366" data-v6="57705186132134">
    <label class="lh-area__label">
    <span>Delivery area</span>
    <select class="lh-area__select" name="attributes[Delivery area]" form="cart-form" required onchange="lhSetArea(this.value)">
    <option value="">Choose your area</option>
    {%- for a in lh_areas -%}<option value="{{ a }}"{% if lh_area == a %} selected{% endif %}>{{ a }}</option>{%- endfor -%}
    <option value="Other area in Accra"{% if lh_area == 'Other area in Accra' %} selected{% endif %}>Other area in Accra</option>
    <option value="Outside Accra (VIP bus)"{% if lh_area == 'Outside Accra (VIP bus)' %} selected{% endif %}>Outside Accra (VIP bus)</option>
    </select>
    </label>
<p class="lh-area__hint">{% if lh_zone == 5 %}Delivery to {{ lh_area }} is GHS 20, added to your cart. {% elsif lh_zone == 6 %}Delivery to {{ lh_area }} is GHS 30, added to your cart. {% endif %}Outside Accra? Choose the last option and we will send your order to your nearest VIP station.</p></div>
<script> (function(){if(window.lhInit)return;window.lhInit=1;var root=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/';function box(){return document.querySelector('.lh-area');}function zoneOf(v){var d=box();if(!d||!v)return 0;if(d.dataset.z5.split(',').indexOf(v)>-1)return 5;if(d.dataset.z6.split(',').indexOf(v)>-1)return 6;return 0;}async function sync(v,reload){var d=box();if(!d)return false;var v5=Number(d.dataset.v5),v6=Number(d.dataset.v6);var cart=await fetch(root+'cart.js').then(function(r){return r.json();});var others=cart.items.filter(function(i){return i.variant_id!==v5&&i.variant_id!==v6;}).length;var z=others?zoneOf(v):0;var want={};want[v5]=z===5?1:0;want[v6]=z===6?1:0;var have={};have[v5]=0;have[v6]=0;cart.items.forEach(function(i){if(i.variant_id===v5||i.variant_id===v6){have[i.variant_id]+=i.quantity;}});var changed=have[v5]!==want[v5]||have[v6]!==want[v6];var body={attributes:{'Delivery area':v||''}};if(changed){body.updates=want;}await fetch(root+'cart/update.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});if(changed&&reload){location.reload();}return changed;}window.lhSetArea=function(v){document.querySelectorAll('.lh-area__select').forEach(function(s){s.value=v;});sync(v,true);};function current(){var s=document.querySelector('.lh-area__select');return s?s.value:'';}document.addEventListener('click',async function(e){var b=e.target.closest&&e.target.closest('#checkout');if(!b||b.dataset.lhOk)return;var f=document.getElementById('cart-form');if(f&&!f.checkValidity())return;e.preventDefault();await sync(current(),false);b.dataset.lhOk='1';b.click();},true);sync(current(),true);})(); </script>
<style>
.lh-area { display: flex; flex-direction: column; gap: 6px; margin-block-end: 12px; }
.lh-area__label { display: flex; flex-direction: column; gap: 6px; font-size: 0.9em; }
.lh-area__select { width: 100%; padding: 12px; border: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.3); border-radius: 4px; background: transparent; color: inherit; font: inherit; }
.lh-area__hint { margin: 0; font-size: 0.8em; opacity: 0.75; }
.lh-area__select option { color: #1a1a1a; background-color: #ffffff; }
</style>