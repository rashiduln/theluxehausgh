{%- comment -%} Delivery area picker. Saved on the order as the cart attribute "Delivery area". Read by the Flow workflow "Delivery zone and cost tags". {%- endcomment -%}
{%- assign lh_area = cart.attributes['Delivery area'] -%}
QQ1- assign lh_areas = 'Abeka,Abelemkpe,Abokobi,Abossey Okai,Aburi,Accra Mall,Achimota,Adabraka,Adenta,Adjiringanor,Afienya,Agbogba,Airport City,Airport Hills,Airport Residential,Akweteyman,Alajo,Amasaman,American House,Ashaiman,Ashaley Botwe,Ashongman,Ashongman Estate,Asylum Down,Atomic Junction,Awoshie,Ayimensah,Baatsona,Bawaleshie,Burma Camp,Cantonments,Chorkor,Christian Village,Danfa,Dansoman,Darkuman,Dawhenya,Dodowa,Dome,Dome Pillar 2,Dzorwulu,East Legon,East Legon Hills,Gbawe,Haatso,James Town,Kanda,Kaneshie,Kasoa,Kisseman,Kokomlemle,Kokrobite,Korle Bu,Korle Gonno,Kotobabi,Kpone,Kwabenya,Kwashieman,La (Labadi),Labone,Lakeside Estate,Lapaz,Lashibi,Legon (University of Ghana),Madina,Mallam,Mamprobi,Mataheko,McCarthy Hill,Medie,Mile 7,Musuko,Nima,North Kaneshie,North Legon,North Ridge,Nsawam,Nungua,Odorkor,Ofankor,Okponglo,Osu,Oyarifa,Oyibi,Palace Mall,Pantang,Pokuase,Prampram,Regimanuel,Ridge,Roman Ridge,Sakumono,Santa Maria,Shiashie,Spintex,Taifa,Tantra Hill,Tema Community 1,Tema Community 2,Tema Community 3,Tema Community 4,Tema Community 5,Tema Community 6,Tema Community 7,Tema Community 8,Tema Community 9,Tema Community 10,Tema Community 11,Tema Community 12,Tema Community 13,Tema Community 14,Tema Community 15,Tema Community 16,Tema Community 17,Tema Community 18,Tema Community 19,Tema Community 20,Tema Community 21,Tema Community 22,Tema Community 23,Tema Community 24,Tema Community 25,Tema Community 26,Tema Industrial Area,Tema Newtown,Tesano,Teshie,Tetteh Quarshie,Trasacco,Weija,West Legon,Westlands' | split: ',' -QQ2
<div class="lh-area">
    <label class="lh-area__label">
    <span>Delivery area</span>
    <select class="lh-area__select" name="attributes[Delivery area]" form="cart-form" required onchange="lhSetArea(this.value)">
    <option value="">Choose your area</option>
    {%- for a in lh_areas -%}<option value="{{ a }}"{% if lh_area == a %} selected{% endif %}>{{ a }}</option>{%- endfor -%}
    <option value="Other area in Accra"{% if lh_area == 'Other area in Accra' %} selected{% endif %}>Other area in Accra</option>
    <option value="Outside Accra (VIP bus)"{% if lh_area == 'Outside Accra (VIP bus)' %} selected{% endif %}>Outside Accra (VIP bus)</option>
    </select>
    </label>
<p class="lh-area__hint">Outside Accra? Choose the last option and we will send your order to your nearest VIP station.</p></div>
<script> window.lhSetArea = window.lhSetArea || function (v) { document.querySelectorAll('.lh-area__select').forEach(function (s) { s.value = v; }); fetch(window.Shopify.routes.root + 'cart/update.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ attributes: { 'Delivery area': v } }) }); }; </script>
<style>
.lh-area { display: flex; flex-direction: column; gap: 6px; margin-block-end: 12px; }
.lh-area__label { display: flex; flex-direction: column; gap: 6px; font-size: 0.9em; }
.lh-area__select { width: 100%; padding: 12px; border: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.3); border-radius: 4px; background: transparent; color: inherit; font: inherit; }
.lh-area__hint { margin: 0; font-size: 0.8em; opacity: 0.75; }
.lh-area__select option { color: #1a1a1a; background-color: #ffffff; }
</style>