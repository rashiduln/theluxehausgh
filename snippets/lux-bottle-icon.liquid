{%- comment -%}
  Renders an SVG bottle icon for The Luxé Haus
  Usage:
  {% render 'lux-bottle-icon', shape: 'wash', stroke: '#D8611A', champagne: '#C9B48A' %}
{%- endcomment -%}

{%- liquid
  assign s = stroke | default: '#D8611A'
  assign c = champagne | default: '#C9B48A'
-%}

{%- case shape -%}
  {%- when 'wash' -%}
    <svg viewBox="0 0 40 80" class="lux_bottle_svg lux_svg_wash" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <rect x="11" y="3" width="7" height="8" fill="none" stroke="{{ c }}" stroke-width="2"/>
      <rect x="5" y="11" width="18" height="66" rx="3" fill="none" stroke="{{ s }}" stroke-width="2"/>
    </svg>
  {%- when 'cream' -%}
    <svg viewBox="0 0 44 80" class="lux_bottle_svg lux_svg_cream" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <rect x="6" y="22" width="32" height="55" rx="4" fill="none" stroke="{{ s }}" stroke-width="2"/>
      <rect x="11" y="11" width="22" height="11" fill="none" stroke="{{ c }}" stroke-width="2"/>
    </svg>
  {%- when 'spray' -%}
    <svg viewBox="0 0 40 80" class="lux_bottle_svg lux_svg_spray" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <rect x="15" y="3" width="9" height="7" fill="none" stroke="{{ c }}" stroke-width="2"/>
      <rect x="13" y="10" width="14" height="7" fill="none" stroke="{{ c }}" stroke-width="2"/>
      <rect x="6" y="17" width="28" height="60" rx="7" fill="none" stroke="{{ s }}" stroke-width="2"/>
    </svg>
  {%- when 'cloth' -%}
    <svg viewBox="0 0 56 80" class="lux_bottle_svg lux_svg_cloth" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <rect x="4" y="30" width="48" height="46" fill="#3B2A24" stroke="{{ s }}" stroke-width="2"/>
      <path d="M10 36l36 34M10 50l22 20M24 36l22 20M46 36L10 70M32 36L10 56M46 50L24 70" stroke="{{ c }}" stroke-width="1" opacity=".7"/>
    </svg>
  {%- when 'room' -%}
    <svg viewBox="0 0 34 80" class="lux_bottle_svg lux_svg_room" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <rect x="13" y="2" width="8" height="8" fill="none" stroke="{{ c }}" stroke-width="2"/>
      <rect x="11" y="10" width="12" height="6" fill="none" stroke="{{ c }}" stroke-width="2"/>
      <rect x="7" y="16" width="20" height="61" rx="4" fill="none" stroke="{{ c }}" stroke-width="2"/>
      <path d="M12 44h10" stroke="{{ s }}" stroke-width="2"/>
    </svg>
{%- endcase -%}
